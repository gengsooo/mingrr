rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================================
    // 헬퍼 함수들
    // ============================================================
    
    // 로그인한 사용자인지 확인
    function isSignedIn() {
      return request.auth != null;
    }
    
    // 본인의 데이터인지 확인
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // 문서가 존재하는지 확인
    function existingData() {
      return resource.data;
    }
    
    // 새로운 데이터
    function incomingData() {
      return request.resource.data;
    }
    
    // 관리자 계정인지 확인 (더미 데이터 생성용)
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@mingrr.com' ||
        request.auth.token.email == 'gengsooo@gmail.com'
      );
    }
    
    // ============================================================
    // 데이터 크기 제한 함수들
    // ============================================================
    
    
    // 텍스트 길이 제한
    function isValidTextLength(field, maxLength) {
      return !incomingData().keys().hasAny([field]) || incomingData()[field].size() <= maxLength;
    }
    
    // 메시지 길이 제한 (1000자)
    function isValidMessageLength() {
      return incomingData().content.size() <= 1000;
    }
    
    // 게시글 내용 길이 제한 (5000자)
    function isValidPostContentLength() {
      return incomingData().content.size() <= 5000;
    }
    
    // ============================================================
    // users Collection - 사용자(보호자) 정보
    // ============================================================
    match /users/{userId} {
      // 읽기: 
      // - 로그인한 사용자는 모든 사용자 정보 조회 가능
      // - 이메일 중복 검사용: 인증 없이 이메일 필드 쿼리 허용 (limit 1)
      allow read: if isAdmin() || isSignedIn();
      
      // 이메일 중복 검사용 리스트 쿼리 (회원가입 시 인증 전 상태에서 사용)
      allow list: if request.query.limit <= 1;
      
      // 생성: 본인 계정만 생성 가능 (또는 관리자)
      allow create: if isOwner(userId) || isAdmin();
      
      // 수정: 본인 계정만 수정 가능 (또는 관리자)
      allow update: if isOwner(userId) || isAdmin();
      
      // 삭제: 본인 계정만 삭제 가능 (또는 관리자)
      allow delete: if isOwner(userId) || isAdmin();
    }
    
    // ============================================================
    // pets Collection - 반려동물 정보
    // ============================================================
    match /pets/{petId} {
      // 읽기: 로그인한 사용자는 모든 반려동물 정보 조회 가능 (관리자는 무조건 가능)
      allow read: if isAdmin() || isSignedIn();
      
      // 생성: 본인 소유의 반려동물만 생성 가능 (또는 관리자)
      allow create: if isAdmin() || (isSignedIn() && incomingData().ownerId == request.auth.uid);
      
      // 수정: 본인 소유 또는 likeCount만 변경하는 경우 허용 (좋아요 기능)
      allow update: if isAdmin() || (isSignedIn() && (
        existingData().ownerId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
      ));
      
      // 삭제: 본인 소유의 반려동물만 삭제 가능 (또는 관리자)
      allow delete: if isAdmin() || (isSignedIn() && existingData().ownerId == request.auth.uid);
    }
    
    // ============================================================
    // chatRooms Collection - 채팅방
    // ============================================================
    match /chatRooms/{chatRoomId} {
      // 읽기: 채팅방 참여자 또는 관리자만 조회 가능
      allow read: if isAdmin() || (isSignedIn()
        && request.auth.uid in resource.data.participantIds);
      
      // 생성: 로그인한 사용자가 참여자에 포함되어 있으면 생성 가능 (또는 관리자)
      allow create: if isAdmin() || (isSignedIn()
        && request.auth.uid in incomingData().participantIds);
      
      // 수정: 채팅방 참여자만 수정 가능 (또는 관리자)
      allow update: if isAdmin() || (isSignedIn()
        && request.auth.uid in existingData().participantIds);
      
      // 삭제: 채팅방 참여자 또는 관리자만 삭제 가능
      allow delete: if isAdmin() || (isSignedIn()
        && request.auth.uid in existingData().participantIds);
    }
    
    // ============================================================
    // messages Collection - 메시지 (chatRooms 하위 컬렉션)
    // ============================================================
    match /chatRooms/{chatRoomId}/messages/{messageId} {
      // 읽기: 채팅방 참여자 또는 관리자만 조회 가능
      allow read: if isAdmin() || (isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(chatRoomId)).data.participantIds);
      
      // 생성: 본인이 발신자인 메시지만 생성 가능 + 크기 제한 (또는 관리자)
      allow create: if isAdmin() || (isSignedIn()
        && incomingData().senderId == request.auth.uid
        && incomingData().chatRoomId == chatRoomId
        && isValidMessageLength());
      
      // 수정: 메시지 읽음 상태만 수정 가능 (또는 관리자)
      allow update: if isAdmin() || (isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(chatRoomId)).data.participantIds);
      
      // 삭제: 본인이 보낸 메시지 또는 관리자만 삭제 가능
      allow delete: if isAdmin() || (isSignedIn()
        && existingData().senderId == request.auth.uid);
    }
    
    // ============================================================
    // likes Collection - 반려동물 좋아요 (데이팅 화면에서 사용)
    // 문서 ID 형식: {userId}_{petId}
    // ============================================================
    match /likes/{likeId} {
      // 읽기/쓰기: 로그인한 사용자는 모든 작업 가능 (디버깅용 임시 규칙)
      allow read, write: if isAdmin() || isSignedIn();
    }
    
    // ============================================================
    // matches Collection - 매칭 성공
    // ============================================================
    match /matches/{matchId} {
      // 읽기: 매칭 참여자 또는 관리자만 조회 가능
      allow read: if isAdmin() || (isSignedIn()
        && request.auth.uid in resource.data.userIds);
      
      // 생성: 매칭 참여자가 생성 가능 (데이팅 수락 시 매칭 생성)
      allow create: if isAdmin() || (isSignedIn()
        && request.auth.uid in incomingData().userIds);
      
      // 수정: 매칭 참여자만 수정 가능 (또는 관리자)
      allow update: if isAdmin() || (isSignedIn()
        && request.auth.uid in existingData().userIds);
      
      // 삭제: 매칭 참여자 또는 관리자만 삭제 가능
      allow delete: if isAdmin() || (isSignedIn()
        && request.auth.uid in existingData().userIds);
    }
    
    // ============================================================
    // products Collection - 마켓플레이스 상품
    // ============================================================
    match /products/{productId} {
      // 읽기: 로그인한 사용자는 모든 상품 조회 가능 (관리자는 무조건 가능)
      allow read: if isAdmin() || isSignedIn();
      
      // 생성: 본인이 판매자인 상품만 생성 가능 (또는 관리자)
      // 참고: Firestore는 문서당 1MB 제한이 있으므로 별도 크기 검증 불필요
      allow create: if isAdmin() || (isSignedIn() 
        && incomingData().sellerId == request.auth.uid);
      
      // 수정: 본인이 판매자인 상품만 수정 가능 (또는 관리자)
      allow update: if isAdmin() || (isSignedIn() && existingData().sellerId == request.auth.uid);
      
      // 삭제: 본인이 판매자인 상품만 삭제 가능 (또는 관리자)
      allow delete: if isAdmin() || (isSignedIn() && existingData().sellerId == request.auth.uid);
    }
    
    // ============================================================
    // productLikes Collection - 상품 찜
    // ============================================================
    match /productLikes/{likeId} {
      // 읽기: 본인이 찜한 상품 또는 관리자만 조회 가능
      allow read: if isAdmin() || (isSignedIn()
        && resource.data.userId == request.auth.uid);
      
      // 생성: 본인 계정으로만 찜 가능 (또는 관리자)
      allow create: if isAdmin() || (isSignedIn()
        && incomingData().userId == request.auth.uid);
      
      // 삭제: 본인이 찜한 상품 또는 관리자만 삭제 가능
      allow delete: if isAdmin() || (isSignedIn()
        && existingData().userId == request.auth.uid);
    }
    
    // ============================================================
    // groupLikes Collection - 소모임 좋아요
    // ============================================================
    match /groupLikes/{likeId} {
      allow read: if isAdmin() || isSignedIn();
      allow create: if isAdmin() || (isSignedIn() && incomingData().userId == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && existingData().userId == request.auth.uid);
    }
    
    // ============================================================
    // groups Collection - 소모임
    // ============================================================
    match /groups/{groupId} {
      // 읽기: 로그인한 사용자는 모임 조회 가능 (creatorId 쿼리, 공개/비공개 모두)
      allow read: if isAdmin() || isSignedIn();
      
      // 생성: 로그인한 사용자는 모임 생성 가능 (또는 관리자)
      allow create: if isAdmin() || (isSignedIn() && incomingData().creatorId == request.auth.uid);
      
      // 수정: 관리자/생성자 또는 멤버 가입/탈퇴 시 memberIds/memberCount만 변경 허용
      allow update: if isAdmin() || (isSignedIn() && (
        // 관리자/생성자는 모든 필드 수정 가능
        request.auth.uid == existingData().creatorId || 
        request.auth.uid in existingData().adminIds ||
        // 일반 사용자는 memberIds/memberCount만 변경 가능 (가입/탈퇴)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'memberCount']))
      ));
      
      // 삭제: 생성자만 삭제 가능 (또는 시스템 관리자)
      allow delete: if isAdmin() || (isSignedIn() && existingData().creatorId == request.auth.uid);
    }
    
    // ============================================================
    // schedules Collection - 모임 일정
    // ============================================================
    match /schedules/{scheduleId} {
      // 읽기: 해당 모임 멤버만 조회 가능 (또는 관리자)
      allow read: if isAdmin() || isSignedIn();
      
      // 생성: 모임 관리자만 생성 가능 (또는 시스템 관리자)
      allow create: if isAdmin() || (isSignedIn() && incomingData().creatorId == request.auth.uid);
      
      // 수정: 생성자 또는 참가자가 수정 가능 (또는 시스템 관리자)
      allow update: if isAdmin() || (isSignedIn() && (request.auth.uid == existingData().creatorId || request.auth.uid in existingData().participantIds));
      
      // 삭제: 생성자만 삭제 가능 (또는 시스템 관리자)
      allow delete: if isAdmin() || (isSignedIn() && existingData().creatorId == request.auth.uid);
    }
    
    // ============================================================
    // joinRequests Collection - 모임 가입 신청 (레거시)
    // ============================================================
    match /joinRequests/{requestId} {
      // 읽기: 신청자 또는 모임 관리자 또는 시스템 관리자만 조회 가능
      allow read: if isAdmin() || isSignedIn();
      
      // 생성: 본인 계정으로만 신청 가능 (또는 관리자)
      allow create: if isAdmin() || (isSignedIn()
        && incomingData().userId == request.auth.uid);
      
      // 수정: 모임 관리자만 승인/거절 가능 (또는 시스템 관리자)
      allow update: if isAdmin() || isSignedIn();
      
      // 삭제: 신청자 본인 또는 관리자만 삭제 가능
      allow delete: if isAdmin() || (isSignedIn()
        && existingData().userId == request.auth.uid);
    }
    
    // ============================================================
    // groupJoinRequests Collection - 소모임 가입 신청 (실제 사용)
    // 코드에서 groupJoinRequestsCollection 사용
    // ============================================================
    match /groupJoinRequests/{requestId} {
      // 읽기: 로그인한 사용자는 조회 가능
      allow read: if isAdmin() || isSignedIn();
      
      // 생성: 본인 계정으로만 신청 가능 (또는 관리자)
      allow create: if isAdmin() || (isSignedIn()
        && incomingData().userId == request.auth.uid);
      
      // 수정: 로그인한 사용자는 승인/거절 가능 (모임 관리자 체크는 앱에서)
      allow update: if isAdmin() || isSignedIn();
      
      // 삭제: 신청자 본인 또는 관리자만 삭제 가능
      allow delete: if isAdmin() || (isSignedIn()
        && existingData().userId == request.auth.uid);
    }
    
    // ============================================================
    // jobs Collection - 알바 (펫시터/산책 등)
    // 코드에서 userId 필드 사용
    // ============================================================
    match /jobs/{jobId} {
      // 읽기: 로그인한 사용자는 모든 알바 조회 가능 (관리자는 무조건 가능)
      allow read: if isAdmin() || isSignedIn();
      
      // 생성: 본인이 작성자인 알바만 생성 가능 (또는 관리자)
      allow create: if isAdmin() || (isSignedIn() && incomingData().userId == request.auth.uid);
      
      // 수정: 본인이 작성자인 알바만 수정 가능 (또는 관리자)
      allow update: if isAdmin() || (isSignedIn() && existingData().userId == request.auth.uid);
      
      // 삭제: 본인이 작성자인 알바만 삭제 가능 (또는 관리자)
      allow delete: if isAdmin() || (isSignedIn() && existingData().userId == request.auth.uid);
    }
    
    // ============================================================
    // walks Collection - 산책 기록
    // ============================================================
    match /walks/{walkId} {
      // 읽기: 본인의 산책 기록만 조회 가능 (관리자는 무조건 가능)
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      
      // 생성: 본인 계정으로만 산책 기록 생성 가능 (또는 관리자)
      allow create: if isAdmin() || (isSignedIn() && incomingData().userId == request.auth.uid);
      
      // 수정: 본인의 산책 기록만 수정 가능 (또는 관리자)
      allow update: if isAdmin() || (isSignedIn() && existingData().userId == request.auth.uid);
      
      // 삭제: 본인의 산책 기록만 삭제 가능 (또는 관리자)
      allow delete: if isAdmin() || (isSignedIn() && existingData().userId == request.auth.uid);
    }
    
    // ============================================================
    // healthRecords Collection - 건강 기록 (pets 하위 컬렉션)
    // ============================================================
    match /pets/{petId}/healthRecords/{recordId} {
      // 읽기: 반려동물 주인 또는 관리자만 조회 가능
      allow read: if isAdmin() || (isSignedIn()
        && get(/databases/$(database)/documents/pets/$(petId)).data.ownerId == request.auth.uid);
      
      // 생성: 반려동물 주인만 생성 가능 (또는 관리자)
      allow create: if isAdmin() || (isSignedIn()
        && get(/databases/$(database)/documents/pets/$(petId)).data.ownerId == request.auth.uid);
      
      // 수정: 반려동물 주인만 수정 가능 (또는 관리자)
      allow update: if isAdmin() || (isSignedIn()
        && get(/databases/$(database)/documents/pets/$(petId)).data.ownerId == request.auth.uid);
      
      // 삭제: 반려동물 주인 또는 관리자만 삭제 가능
      allow delete: if isAdmin() || (isSignedIn()
        && get(/databases/$(database)/documents/pets/$(petId)).data.ownerId == request.auth.uid);
    }
    
    // ============================================================
    // 건강수첩 컬렉션들 (체중, 산책, 그루밍, 예방접종, 검진, 약, 특이사항)
    // 코드에서 camelCase 사용: weightRecords, walkRecords 등
    // ============================================================
    match /weightRecords/{recordId} {
      allow read: if isAdmin() || isSignedIn();
      allow create: if isAdmin() || isSignedIn();
      allow update: if isAdmin() || isSignedIn();
      allow delete: if isAdmin() || isSignedIn();
    }
    
    match /walkRecords/{recordId} {
      allow read: if isAdmin() || isSignedIn();
      allow create: if isAdmin() || isSignedIn();
      allow update: if isAdmin() || isSignedIn();
      allow delete: if isAdmin() || isSignedIn();
    }
    
    match /groomingRecords/{recordId} {
      allow read: if isAdmin() || isSignedIn();
      allow create: if isAdmin() || isSignedIn();
      allow update: if isAdmin() || isSignedIn();
      allow delete: if isAdmin() || isSignedIn();
    }
    
    match /vaccinationRecords/{recordId} {
      allow read: if isAdmin() || isSignedIn();
      allow create: if isAdmin() || isSignedIn();
      allow update: if isAdmin() || isSignedIn();
      allow delete: if isAdmin() || isSignedIn();
    }
    
    match /checkupRecords/{recordId} {
      allow read: if isAdmin() || isSignedIn();
      allow create: if isAdmin() || isSignedIn();
      allow update: if isAdmin() || isSignedIn();
      allow delete: if isAdmin() || isSignedIn();
    }
    
    match /medicationRecords/{recordId} {
      allow read: if isAdmin() || isSignedIn();
      allow create: if isAdmin() || isSignedIn();
      allow update: if isAdmin() || isSignedIn();
      allow delete: if isAdmin() || isSignedIn();
    }
    
    match /special_notes/{recordId} {
      allow read: if isAdmin() || isSignedIn();
      allow create: if isAdmin() || isSignedIn();
      allow update: if isAdmin() || isSignedIn();
      allow delete: if isAdmin() || isSignedIn();
    }
    
    // ============================================================
    // feedPosts Collection - 커뮤니티 피드 게시글
    // ============================================================
    match /feedPosts/{postId} {
      // 읽기: 로그인한 사용자는 모든 게시글 조회 가능
      allow read: if isAdmin() || isSignedIn();
      
      // 생성: 본인이 작성자인 게시글만 생성 가능
      allow create: if isAdmin() || (isSignedIn() 
        && incomingData().authorId == request.auth.uid
        && isValidPostContentLength());
      
      // 수정: 본인이 작성자인 게시글만 수정 가능
      allow update: if isAdmin() || (isSignedIn() && existingData().authorId == request.auth.uid);
      
      // 삭제: 본인이 작성자인 게시글만 삭제 가능
      allow delete: if isAdmin() || (isSignedIn() && existingData().authorId == request.auth.uid);
    }
    
    // ============================================================
    // feedComments Collection - 커뮤니티 피드 댓글
    // ============================================================
    match /feedComments/{commentId} {
      // 읽기: 로그인한 사용자는 모든 댓글 조회 가능
      allow read: if isAdmin() || isSignedIn();
      
      // 생성: 본인이 작성자인 댓글만 생성 가능
      allow create: if isAdmin() || (isSignedIn() 
        && incomingData().authorId == request.auth.uid
        && isValidTextLength('content', 1000));
      
      // 수정: 본인이 작성자인 댓글만 수정 가능
      allow update: if isAdmin() || (isSignedIn() && existingData().authorId == request.auth.uid);
      
      // 삭제: 본인이 작성자인 댓글만 삭제 가능
      allow delete: if isAdmin() || (isSignedIn() && existingData().authorId == request.auth.uid);
    }
    
    // ============================================================
    // feedLikes Collection - 커뮤니티 피드 좋아요
    // ============================================================
    match /feedLikes/{likeId} {
      // 읽기: 로그인한 사용자는 조회 가능
      allow read: if isAdmin() || isSignedIn();
      
      // 생성: 본인 계정으로만 좋아요 가능
      allow create: if isAdmin() || (isSignedIn() && incomingData().userId == request.auth.uid);
      
      // 삭제: 본인이 좋아요한 것만 삭제 가능
      allow delete: if isAdmin() || (isSignedIn() && existingData().userId == request.auth.uid);
    }
    
    // ============================================================
    // dating_requests Collection - 데이팅 신청
    // ============================================================
    match /dating_requests/{requestId} {
      // 읽기: 본인이 보냈거나 받은 신청 조회 가능
      // 중복 신청 체크를 위해 fromPetId/toPetId 쿼리도 허용
      allow read: if isAdmin() || isSignedIn();
      
      // 생성: 본인이 발신자인 신청만 생성 가능
      allow create: if isAdmin() || (isSignedIn()
        && incomingData().fromUserId == request.auth.uid);
      
      // 수정: 받은 사람만 상태 변경 가능 (수락/거절)
      allow update: if isAdmin() || (isSignedIn()
        && existingData().toUserId == request.auth.uid);
      
      // 삭제: 본인이 보낸 신청만 삭제 가능
      allow delete: if isAdmin() || (isSignedIn()
        && existingData().fromUserId == request.auth.uid);
    }
    
    // ============================================================
    // breedingPosts Collection - 교배 게시글
    // ============================================================
    match /breedingPosts/{postId} {
      allow read: if isAdmin() || isSignedIn();
      allow create: if isAdmin() || (isSignedIn() && incomingData().authorId == request.auth.uid);
      allow update: if isAdmin() || (isSignedIn() && existingData().authorId == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && existingData().authorId == request.auth.uid);
    }
    
    // ============================================================
    // ratings Collection - 꼬순내 평가
    // ============================================================
    match /ratings/{ratingId} {
      allow read: if isAdmin() || isSignedIn();
      allow create: if isAdmin() || (isSignedIn() && incomingData().raterId == request.auth.uid);
      allow update: if isAdmin() || (isSignedIn() && existingData().raterId == request.auth.uid);
      allow delete: if isAdmin();  // 평가 삭제는 관리자만
    }
    
    // ============================================================
    // transaction_statuses Collection - 거래 상태
    // ============================================================
    match /transaction_statuses/{statusId} {
      // 읽기: 거래 당사자만 조회 가능
      allow read: if isAdmin() || (isSignedIn() 
        && (request.auth.uid == resource.data.sellerId || request.auth.uid == resource.data.buyerId));
      // 생성: 거래 당사자만 생성 가능
      allow create: if isAdmin() || (isSignedIn() 
        && (incomingData().sellerId == request.auth.uid || incomingData().buyerId == request.auth.uid));
      // 수정: 거래 당사자만 수정 가능
      allow update: if isAdmin() || (isSignedIn() 
        && (existingData().sellerId == request.auth.uid || existingData().buyerId == request.auth.uid));
      // 삭제: 관리자만
      allow delete: if isAdmin();
    }
    
    // ============================================================
    // petLikes Collection - 반려동물 찜
    // ============================================================
    match /petLikes/{likeId} {
      allow read: if isAdmin() || isSignedIn();
      allow create: if isAdmin() || (isSignedIn() && incomingData().userId == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && existingData().userId == request.auth.uid);
    }
    
    // ============================================================
    // favorites Collection - 통합 찜 (반려동물/상품/소모임)
    // FavoriteService에서 사용하는 통합 찜 컬렉션
    // ============================================================
    match /favorites/{favoriteId} {
      // 읽기: 로그인한 사용자는 조회 가능 (targetId + createdAt 쿼리 허용)
      allow read: if isAdmin() || isSignedIn();
      // 생성: 본인 계정으로만 찜 가능
      allow create: if isAdmin() || (isSignedIn() && incomingData().userId == request.auth.uid);
      // 삭제: 본인이 찜한 항목만 삭제 가능
      allow delete: if isAdmin() || (isSignedIn() && existingData().userId == request.auth.uid);
    }
    
    // ============================================================
    // notifications Collection - 알림
    // 코드에서 recipientId 필드 사용
    // ============================================================
    match /notifications/{notificationId} {
      // 읽기: 본인 알림만 조회 가능
      allow read: if isAdmin() || (isSignedIn() && resource.data.recipientId == request.auth.uid);
      // 생성: 로그인한 사용자는 알림 생성 가능 (앱에서 직접 생성)
      allow create: if isAdmin() || isSignedIn();
      // 수정: 본인 알림만 수정 가능 (읽음 처리)
      allow update: if isAdmin() || (isSignedIn() && existingData().recipientId == request.auth.uid);
      // 삭제: 본인 알림만 삭제 가능
      allow delete: if isAdmin() || (isSignedIn() && existingData().recipientId == request.auth.uid);
    }
    
    // ============================================================
    // blocks Collection - 차단
    // ============================================================
    match /blocks/{blockId} {
      // 읽기: 본인이 차단한 목록만 조회 가능
      allow read: if isAdmin() || (isSignedIn() && resource.data.blockerId == request.auth.uid);
      // 생성: 본인 계정으로만 차단 가능
      allow create: if isAdmin() || (isSignedIn() && incomingData().blockerId == request.auth.uid);
      // 삭제: 본인이 차단한 것만 해제 가능
      allow delete: if isAdmin() || (isSignedIn() && existingData().blockerId == request.auth.uid);
    }
    
    // ============================================================
    // reports Collection - 신고
    // ============================================================
    match /reports/{reportId} {
      // 읽기: 관리자만 조회 가능
      allow read: if isAdmin();
      // 생성: 본인 계정으로만 신고 가능
      allow create: if isAdmin() || (isSignedIn() && incomingData().reporterId == request.auth.uid);
      // 수정: 관리자만 처리 가능
      allow update: if isAdmin();
      // 삭제: 관리자만 삭제 가능
      allow delete: if isAdmin();
    }
    
    // ============================================================
    // config Collection - 앱 설정 (앱 버전, 꼬순내 설정 등)
    // ============================================================
    match /config/{configId} {
      // 읽기: 로그인한 사용자는 조회 가능
      allow read: if isAdmin() || isSignedIn();
      // 쓰기: 관리자만 가능
      allow write: if isAdmin();
    }
    
    // ============================================================
    // kkosunnae_config Collection - 꼬순내지수 설정 (레거시, config로 통합 예정)
    // ============================================================
    match /kkosunnae_config/{configId} {
      allow read: if isAdmin() || isSignedIn();
      allow write: if isAdmin();
    }
    
    // ============================================================
    // transactions Collection - 거래 상태 (rating_service에서 사용)
    // ============================================================
    match /transactions/{transactionId} {
      // 읽기: 거래 당사자만 조회 가능
      allow read: if isAdmin() || (isSignedIn() 
        && (request.auth.uid == resource.data.sellerId || request.auth.uid == resource.data.buyerId));
      // 생성: 거래 당사자만 생성 가능
      allow create: if isAdmin() || (isSignedIn() 
        && (incomingData().sellerId == request.auth.uid || incomingData().buyerId == request.auth.uid));
      // 수정: 거래 당사자만 수정 가능
      allow update: if isAdmin() || (isSignedIn() 
        && (existingData().sellerId == request.auth.uid || existingData().buyerId == request.auth.uid));
      // 삭제: 관리자만
      allow delete: if isAdmin();
    }
    
    // ============================================================
    // posts Collection - 커뮤니티 게시글 (꼬순내 점수 계산용)
    // feedPosts와 별도로 존재하는 레거시 컬렉션
    // ============================================================
    match /posts/{postId} {
      allow read: if isAdmin() || isSignedIn();
      allow create: if isAdmin() || (isSignedIn() && incomingData().authorId == request.auth.uid);
      allow update: if isAdmin() || (isSignedIn() && existingData().authorId == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && existingData().authorId == request.auth.uid);
    }
    
    // ============================================================
    // comments Collection - 커뮤니티 댓글 (꼬순내 점수 계산용)
    // feedComments와 별도로 존재하는 레거시 컬렉션
    // ============================================================
    match /comments/{commentId} {
      allow read: if isAdmin() || isSignedIn();
      allow create: if isAdmin() || (isSignedIn() && incomingData().authorId == request.auth.uid);
      allow update: if isAdmin() || (isSignedIn() && existingData().authorId == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && existingData().authorId == request.auth.uid);
    }
    
    // ============================================================
    // nicknames Collection - 닉네임 중복 체크용 인덱스
    // 문서 ID = 정규화된 닉네임 (소문자)
    // ============================================================
    match /nicknames/{nickname} {
      // 읽기: 로그인한 사용자는 닉네임 존재 여부 확인 가능
      allow read: if isSignedIn();
      
      // 생성: 본인 userId로만 생성 가능
      allow create: if isSignedIn() && incomingData().userId == request.auth.uid;
      
      // 수정: 본인 userId인 경우만 수정 가능
      allow update: if isSignedIn() && existingData().userId == request.auth.uid;
      
      // 삭제: 본인 userId인 경우만 삭제 가능
      allow delete: if isSignedIn() && existingData().userId == request.auth.uid;
    }
    
    // ============================================================
    // breeding_requests Collection - 교배 신청
    // ============================================================
    match /breeding_requests/{requestId} {
      // 읽기: 본인이 보냈거나 받은 신청만 조회 가능
      allow read: if isAdmin() || (isSignedIn()
        && (request.auth.uid == resource.data.senderId 
            || request.auth.uid == resource.data.receiverId));
      
      // 생성: 본인이 발신자인 신청만 생성 가능
      allow create: if isAdmin() || (isSignedIn()
        && incomingData().senderId == request.auth.uid);
      
      // 수정: 받은 사람만 상태 변경 가능 (수락/거절)
      allow update: if isAdmin() || (isSignedIn()
        && existingData().receiverId == request.auth.uid);
      
      // 삭제: 본인이 보낸 신청만 삭제 가능
      allow delete: if isAdmin() || (isSignedIn()
        && existingData().senderId == request.auth.uid);
    }
  }
}